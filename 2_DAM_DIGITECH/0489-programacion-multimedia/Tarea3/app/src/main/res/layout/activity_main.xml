<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0A0915"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★ APP DE SALUDO ★"
        android:textColor="#FF2A85"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:letterSpacing="0.08"
        android:layout_marginBottom="32dp"
        tools:ignore="HardcodedText" />

    <EditText
        android:id="@+id/etNombre"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:hint="> user_name..."
        android:textColorHint="#5A6075"
        android:textColor="#00FFCC"
        android:backgroundTint="#00FFCC"
        android:fontFamily="monospace"
        android:textSize="16sp"
        android:paddingHorizontal="16dp"
        android:inputType="textPersonName"
        android:autofillHints="name"
        android:layout_marginBottom="24dp"
        tools:ignore="HardcodedText" />

    <Button
        android:id="@+id/btnSaludar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ ! ] GENERAR SALUDO"
        android:textColor="#0A0915"
        android:backgroundTint="#00FFCC"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:paddingHorizontal="28dp"
        android:paddingVertical="14dp"
        android:letterSpacing="0.1"
        android:layout_marginBottom="32dp"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFE600"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textSize="22sp"
        android:gravity="center" />

</LinearLayout>